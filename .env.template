# Argent Sentinel — Per-Org Environment Configuration
# Copy this file for each org: cp .env.template tenants/<org-id>.env
# Then fill in the values below.

# ── Identity ──────────────────────────────────────────────
TENANT_ID=replace-with-org-id
APP_PORT=8000

# ── Secrets (generate unique per org) ─────────────────────
JWT_SECRET=replace-with-strong-secret

# ── Paths (mapped via Docker volumes) ─────────────────────
DB_URL=sqlite:///app/data/argent.db
MODEL_PATH=/app/models/tabnet_weights.pt

# ── ML Configuration ─────────────────────────────────────
# Minimum labeled events before TabNet activates.
# Below this threshold, the policy engine handles all decisions.
TABNET_ACTIVATION_THRESHOLD=3000

# ── Runtime Flags ─────────────────────────────────────────
TENANT_ISOLATION=1
REDIS_ENABLED=0
CLOUD_ACTIONS_ENABLED=0
LOG_FORMAT=json
LOG_LEVEL=INFO
AUTH_ALLOW_INSECURE_DEV=0
